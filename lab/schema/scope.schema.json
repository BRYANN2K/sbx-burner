{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BRYANN2K/agent-lab-sbx/lab/schema/scope.schema.json",
  "title": "agent-lab-sbx scope file",
  "description": "Who authorized what, against which targets, until when. The runner turns it into an sbx network allow-list.",
  "type": "object",
  "required": ["schema_version", "id", "owner", "authorization", "valid", "targets", "techniques"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "owner": {"type": "string", "minLength": 1},
    "authorization": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["own-lab", "written"]},
        "reference": {"type": "string", "description": "Required for type=written: contract, ticket or program URL"},
        "contact": {"type": "string"}
      }
    },
    "valid": {
      "type": "object",
      "required": ["not_before", "not_after"],
      "additionalProperties": false,
      "properties": {
        "not_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "not_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "hosts": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "notes": {"type": "string"}
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["strict", "additive"]},
        "allow": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deny": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "techniques": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "notes": {"type": "string"}
  }
}
