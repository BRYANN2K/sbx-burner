{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "version": "0.76.2",
          "rules": [
            {
              "id": "DS-0001",
              "shortDescription": {
                "text": "':latest' tag used"
              }
            },
            {
              "id": "DS-0002",
              "shortDescription": {
                "text": "Image user should not be 'root'"
              }
            },
            {
              "id": "DS-0026",
              "shortDescription": {
                "text": "No HEALTHCHECK defined"
              }
            },
            {
              "id": "DS-0029",
              "shortDescription": {
                "text": "'apt-get' missing '--no-install-recommends'"
              }
            },
            {
              "id": "KSV-0001",
              "shortDescription": {
                "text": "Can elevate its own privileges"
              }
            },
            {
              "id": "KSV-0003",
              "shortDescription": {
                "text": "Default capabilities: some containers do not drop all"
              }
            },
            {
              "id": "KSV-0004",
              "shortDescription": {
                "text": "Default capabilities: some containers do not drop any"
              }
            },
            {
              "id": "KSV-0011",
              "shortDescription": {
                "text": "CPU not limited"
              }
            },
            {
              "id": "KSV-0012",
              "shortDescription": {
                "text": "Runs as root user"
              }
            },
            {
              "id": "KSV-0014",
              "shortDescription": {
                "text": "Root file system is not read-only"
              }
            },
            {
              "id": "KSV-0015",
              "shortDescription": {
                "text": "CPU requests not specified"
              }
            },
            {
              "id": "KSV-0016",
              "shortDescription": {
                "text": "Memory requests not specified"
              }
            },
            {
              "id": "KSV-0017",
              "shortDescription": {
                "text": "Privileged"
              }
            },
            {
              "id": "KSV-0018",
              "shortDescription": {
                "text": "Memory not limited"
              }
            },
            {
              "id": "KSV-0020",
              "shortDescription": {
                "text": "Runs with UID <= 10000"
              }
            },
            {
              "id": "KSV-0021",
              "shortDescription": {
                "text": "Runs with GID <= 10000"
              }
            },
            {
              "id": "KSV-0023",
              "shortDescription": {
                "text": "hostPath volumes mounted"
              }
            },
            {
              "id": "KSV-0030",
              "shortDescription": {
                "text": "Runtime/Default Seccomp profile not set"
              }
            },
            {
              "id": "KSV-0104",
              "shortDescription": {
                "text": "Seccomp policies disabled"
              }
            },
            {
              "id": "KSV-0106",
              "shortDescription": {
                "text": "Container capabilities must only include NET_BIND_SERVICE"
              }
            },
            {
              "id": "KSV-0118",
              "shortDescription": {
                "text": "Default security context configured"
              }
            },
            {
              "id": "KSV-0121",
              "shortDescription": {
                "text": "Kubernetes resource with disallowed volumes mounted"
              }
            },
            {
              "id": "KSV-0125",
              "shortDescription": {
                "text": "Restrict container images to trusted registries"
              }
            },
            {
              "id": "AWS-0086",
              "shortDescription": {
                "text": "S3 Access block should block public ACL"
              }
            },
            {
              "id": "AWS-0087",
              "shortDescription": {
                "text": "S3 Access block should block public policy"
              }
            },
            {
              "id": "AWS-0089",
              "shortDescription": {
                "text": "S3 Bucket Logging"
              }
            },
            {
              "id": "AWS-0090",
              "shortDescription": {
                "text": "S3 Data should be versioned"
              }
            },
            {
              "id": "AWS-0091",
              "shortDescription": {
                "text": "S3 Access Block should Ignore Public ACL"
              }
            },
            {
              "id": "AWS-0093",
              "shortDescription": {
                "text": "S3 Access block should restrict public bucket to limit access"
              }
            },
            {
              "id": "AWS-0094",
              "shortDescription": {
                "text": "S3 buckets should each define an aws_s3_bucket_public_access_block"
              }
            },
            {
              "id": "AWS-0107",
              "shortDescription": {
                "text": "Security groups should not allow unrestricted ingress to SSH or RDP from any IP address."
              }
            },
            {
              "id": "AWS-0132",
              "shortDescription": {
                "text": "S3 encryption should use Customer Managed Keys"
              }
            }
          ]
        }
