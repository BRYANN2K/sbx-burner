          "ruleId": "DS-0001",
          "level": "warning",
          "message": {
            "text": "Artifact: app/Dockerfile\nType: dockerfile\nVulnerability DS-0001\nSeverity: MEDIUM\nMessage: Specify a tag in the 'FROM' statement for image 'debian'\nLink: [DS-0001](https://avd.aquasec.com/misconfig/ds-0001)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/Dockerfile",
                  "uriBaseId": "ROOTPATH"
                },
