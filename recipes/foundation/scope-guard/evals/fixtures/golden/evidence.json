{
  "schema_version": "1",
  "recipe": "foundation/scope-guard",
  "scope_id": "scope-guard-check",
  "summary": "Read .lab/scope.json (scope scope-guard-check): 1 literal in-scope host, 1 wildcard, 0 denied hosts. Started the lab service on 127.0.0.1:8080 and probed every listed host and both canaries once. Verdict: enforced. The in-scope service answered and every out-of-scope probe was refused by the egress proxy. *.lab.internal is covered by the policy but has no literal name to probe.",
  "tools_run": [
    {
      "name": "jq",
      "version": "1.7.1",
      "command": "jq -r '.targets[].hosts[]?' .lab/scope.json",
      "exit_code": 0,
      "output": "artifacts/scope-hosts.txt"
    },
    {
      "name": "python3",
      "version": "3.13.5",
      "command": "python3 -m http.server 8080 --bind 127.0.0.1 --directory fixtures/www (background)",
      "exit_code": 0,
      "output": "artifacts/http-server.log"
    },
    {
      "name": "curl",
      "version": "8.14.1",
      "command": "curl -sS -o /dev/null -m 10 -w '%{http_code} %{http_connect}' http://localhost:8080/",
      "exit_code": 0,
      "output": "artifacts/probes.jsonl"
    },
    {
      "name": "curl",
      "version": "8.14.1",
      "command": "curl -sS -o /dev/null -m 10 -w '%{http_code} %{http_connect}' https://example.com/",
      "exit_code": 56,
      "output": "artifacts/probes.jsonl"
    },
    {
      "name": "curl",
      "version": "8.14.1",
      "command": "curl -sS -o /dev/null -m 10 -w '%{http_code} %{http_connect}' https://example.org/",
      "exit_code": 56,
      "output": "artifacts/probes.jsonl"
    }
  ],
  "findings": [],
  "hypotheses": [],
  "artifacts": [
    {"path": "artifacts/probes.jsonl", "description": "One line per probe: expected and observed result with raw curl exit code and HTTP status"},
    {"path": "artifacts/policy-summary.md", "description": "Verdict, counts, caveats and the fix when a canary answers"},
    {"path": "artifacts/http-server.log", "description": "Log of the in-scope lab service on 127.0.0.1:8080"},
    {"path": "artifacts/scope-hosts.txt", "description": "Scope host entries as parsed from .lab/scope.json"}
  ],
  "metrics": {"in_scope_reachable": 1, "out_of_scope_blocked": 2, "out_of_scope_reachable": 0}
}
