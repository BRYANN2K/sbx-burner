# node:20-alpine, multi-arch index digest.
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
# seed-users.json is generated by build.sh into the build context.
COPY server.js openapi.yaml seed-users.json ./
ENV PORT=3000
# The runner publishes the port on the sandbox loopback only; inside the
# container the app must still listen on all interfaces to be reachable.
ENV BIND_ADDR=0.0.0.0
EXPOSE 3000
USER node
CMD ["node", "server.js"]
